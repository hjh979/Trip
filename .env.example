# TripStar Java local environment example
#
# Copy this file to .env or configure the same values in your IDE / shell.
# Do not commit real API keys, cookies, or runtime_settings.json.

# deepseek / openai-compatible / dashscope
AI_PROVIDER=deepseek
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-v4-pro
AI_TRACE_ENABLED=true
AI_TRACE_DIR=./logs/ai-trace

AMAP_ENABLED=false
AMAP_KEY=your_amap_web_service_key_here
AMAP_JS_SECURITY_CODE=your_amap_js_api_security_code_here

XHS_ENABLED=false
XHS_MODE=service
XHS_COOKIE=your_xhs_cookie_here
# Optional. Default uses bundled resources in src/main/resources/xhs_sign.
XHS_SIGN_DIR=classpath:xhs_sign
# IDEA 从 backend 目录启动时，可使用项目内置 Node；系统已配置 node 时也可写 node。
XHS_NODE_COMMAND=../.tools/node/node.exe

DB_URL=jdbc:mysql://localhost:3307/tripstar?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# 推荐本地 Ollama 中文 Embedding；DeepSeek API 本身不提供 Embedding。
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama-local
EMBEDDING_MODEL=qllama/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
MILVUS_COLLECTION=voyagemind_knowledge_zh
